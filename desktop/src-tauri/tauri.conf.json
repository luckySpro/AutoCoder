{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCoder",
  "version": "0.0.0",
  "identifier": "io.github.luckyspro.autocoder",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "M&J Group",
    "copyright": "© 2026 M&J Group",
    "category": "DeveloperTool",
    "shortDescription": "单机多开发工具协同助手",
    "longDescription": "AutoCoder 让本机的多个 AI 开发工具分工协作：主控规划，其他工具开发、测试和评审，全部围绕 git 进行。",
    "homepage": "https://github.com/luckySpro/AutoCoder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/autocoder-engine"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "wix": {
        "template": "wix/main.wxs"
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
